{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrator",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/sync-on-agents-edit.cjs",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-root-docs.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f package.json ] && { npm run lint || echo \"Linter falhou, verifique os erros\"; } || true",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "[ -f package.json ] && { npm run test || echo \"Testes falharam, favor refatorar\"; } || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
